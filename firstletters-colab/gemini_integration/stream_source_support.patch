+def _private_output_path(path: str | os.PathLike[str]) -> Path:
+    """Detailed mesh/stack/receipt outputs must not be placed in any Git worktree."""
+    resolved = Path(path).resolve()
+    for ancestor in (resolved, *resolved.parents):
