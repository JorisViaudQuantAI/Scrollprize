+        self.assertEqual(receipt["stack_npy_sha256"], hashlib.sha256(stack_path.read_bytes()).hexdigest())
+        self.assertEqual(receipt["support_npz_sha256"], hashlib.sha256(support_path.read_bytes()).hexdigest())
+        with np.load(support_path, allow_pickle=False) as masks:
+            self.assertEqual(set(masks.files), {"mesh_valid_yx", "source_available_lhw", "nonzero_intensity_yx", "full_stack_valid_yx"})
+            for name in masks.files:
+                self.assertEqual(masks[name].dtype, np.bool_)
+                self.assertTrue(masks[name].all())
+        self.assertNotIn("sheet_parallel", json.dumps(receipt["coherence"]))
+
