+def _occupancy_context(
+    roi: tuple[int, int, int, int], patch_size: int, height: int, width: int,
+) -> tuple[int, int, int, int]:
+    # The scheduler checks whole parent-grid patches, including the last
+    # boundary-aligned one. A patch can reach patch_size - 1 beyond the ROI.
+    r0, r1, c0, c1 = roi
+    halo = patch_size - 1
+    return (
+        max(0, r0 - halo), min(height, r1 + halo),
+        max(0, c0 - halo), min(width, c1 + halo),
+    )
 
 
