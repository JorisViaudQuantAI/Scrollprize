+def compute_nonempty_mask_from_lowres_array(
+    array: Any, *, rows: slice = slice(None), cols: slice = slice(None),
+) -> np.ndarray:
+    """Collapse the requested part of a 2D/3D array to a 2D occupancy mask."""
+
+    depth_axis, _ = _occupancy_layout(array)
+    if depth_axis is None:
+        return np.asarray(array[rows, cols]) != 0
+    index = (slice(None), rows, cols) if depth_axis == 0 else (rows, cols, slice(None))
+    return np.any(np.asarray(array[index]) != 0, axis=depth_axis)
+
