diff --git a/vesuvius/tests/ink_detection/test_roi_inference.py b/vesuvius/tests/ink_detection/test_roi_inference.py
index 3e2d190..c1d9031 100644
--- a/vesuvius/tests/ink_detection/test_roi_inference.py
+++ b/vesuvius/tests/ink_detection/test_roi_inference.py
@@ -67,3 +67,51 @@ def test_clipped_real_prediction_assembly_and_raw_zero_skip(tmp_path):
 def test_roi_cli_does_not_rescale_coordinates():
     args=infer.parse_args(['input.zarr','model.pth','out.tif','--resolution','2','--roi','3','83','5','85'])
     assert args.roi==[3,83,5,85] and args.resolution=='2'
+
+
+@pytest.mark.parametrize('layout', ['yx', 'zyx', 'yxz', 'mask-only'])
+@pytest.mark.parametrize('roi', [(129, 130, 177, 179), (252, 263, 339, 353)])
+def test_roi_reads_occupancy_only_in_parent_patch_context(layout, roi):
+    # The only signal near the interior ROI is outside it. Its overlapping
+    # parent patch must still be scheduled. Include ragged edges at scale 4.
+    height, width = 263, 353
+    patch, stride = 32, 16
+    mask = np.zeros((height, width), dtype=bool)
+    mask[121, 171] = True
+    mask[-2, -2] = True
+    pooled = infer.downsample_mask_any(mask, 4, 4)
+    planes = np.stack([np.zeros_like(pooled), pooled])
+    data = {'yx': pooled, 'zyx': planes, 'yxz': np.moveaxis(planes, 0, -1)}
+
+    class RecordedArray:
+        def __init__(self, values):
+            self.values = values
+            self.shape = values.shape
+            self.selections = []
+
+        def __getitem__(self, select):
+            selected = self.values[select]
+            self.selections.append(selected.size)
+            return selected
+
+    class Group(dict):
+        def array_keys(self):
+            return self.keys()
+
+    source = RecordedArray(data.get(layout, pooled))
+    root = source if layout == 'mask-only' else Group({'3': source})
+    kwargs = dict(height=height, width=width, user_mask=mask)
+    full, scale, level = infer.build_lowres_block_mask(root, **kwargs)
+    expected = infer.iter_blocks((height, width), patch, stride, full, scale, roi_bounds=roi)
+    assert expected
+    source.selections.clear()
+    context = infer._occupancy_context(roi, patch, height, width)
+    local, actual_scale, actual_level = infer.build_lowres_block_mask(root, scan_bounds=context, **kwargs)
+    assert (actual_scale, actual_level) == (scale, level)
+    origin = (context[0] // scale[0], context[2] // scale[1])
+    actual = infer.iter_blocks((height, width), patch, stride, local, scale, roi_bounds=roi, mask_origin=origin)
+    assert actual == expected
+    assert local.size < full.size // 4
+    if layout != 'mask-only':
+        assert len(source.selections) == 1
+        assert source.selections[0] < source.values.size // 4
